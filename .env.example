# Voxly AI — Production Environment Configuration
# Copy this file to .env.local or .env for local development

# ==============================================================================
# BACKEND API GATEWAY CONFIGURATION
# ==============================================================================
# Set this to point the user console directly to your custom backend
# (e.g., Python FastAPI, Express, NestJS, Go, Django, etc.)
# If left empty, the console defaults to the built-in local Simulator Engine.
VITE_API_URL=http://localhost:8000/api

# ==============================================================================
# OPTION 1: GOOGLE OAUTH 2.0 (Direct Client-Side GIS)
# ==============================================================================
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" (Web application)
# 3. Add Authorized JavaScript origins: http://localhost:5173 and https://voxly.ai
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# OPTION 2: GITHUB OAUTH APPLICATION
# ==============================================================================
# 1. Visit: https://github.com/settings/developers
# 2. Create "New OAuth App"
# 3. Set Authorization callback URL: http://localhost:5173/auth/callback
VITE_GITHUB_CLIENT_ID=your-github-client-id

# ==============================================================================
# OPTION 3: SUPABASE AUTH (Recommended for Complete Auth + DB in 2 Minutes)
# ==============================================================================
# 1. Create free project at: https://supabase.com
# 2. In Project Settings > API, copy URL and anon public key
# 3. Enable Google & GitHub providers in Supabase Dashboard > Authentication > Providers
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# OPTION 4: TELEPHONY & WEBRTC VOICE API KEYS (Optional for Live Production Dials)
# ==============================================================================
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TELNYX_API_KEY=
VITE_OPENAI_API_KEY=
